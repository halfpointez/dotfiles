{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/Applications/development/desktop/pic/futaba1-ascii-art.txt",
    "padding": {
      "top": 0,
      "left": 1
    },
    // 在这里添加颜色配置
    "color": {
      "1": "magenta", // 将 $1 改为品红色
      "2": "blue", // 将 $2 改为蓝色
      "3": "cyan" // 将 $3 改为青色
      // ... 你可以根据需要配置到 $9
    }
  },
  "display": {
    "separator": " \u001b[38;2;216;191;216m┊\u001b[0m "
  },
  "modules": [
    // 🌸 1. OS Info 区块
    {
      "type": "custom",
      "format": "\u001b[38;2;255;182;193m  🌸 OS Info \u001b[38;2;216;191;216m───────────────────────\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;203;178;254m╭────────────────────────────────────────────────────────╮\u001b[0m"
    },
    {
      "type": "os",
      "key": "  \u001b[38;2;255;182;193m OS\u001b[0m"
    },
    {
      "type": "kernel",
      "key": "  \u001b[38;2;255;182;193m󰻹 Kernel\u001b[0m"
    },
    {
      "type": "host",
      "key": "  \u001b[38;2;255;182;193m Machine\u001b[0m",
      "format": "{name}{?vendor}"
    },
    {
      "type": "display",
      "key": "  \u001b[38;2;255;182;193m󰹑 Display\u001b[0m",
      "format": "{1}x{2} @ {3} Hz"
    },
    {
      "type": "uptime",
      "key": "  \u001b[38;2;255;182;193m󱫐 Uptime\u001b[0m"
    },
    {
      "type": "shell",
      "key": "  \u001b[38;2;255;182;193m Shell\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;203;178;254m╰────────────────────────────────────────────────────────╯\u001b[0m"
    },
    "break",
    // ✨ 2. Hardware & Network 区块
    {
      "type": "custom",
      "format": "\u001b[38;2;216;191;216m  ✨ Hardware & Network \u001b[38;2;255;182;193m────────────\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;203;178;254m╭────────────────────────────────────────────────────────╮\u001b[0m"
    },
    {
      "type": "cpu",
      "format": "{1}",
      "key": "  \u001b[38;2;216;191;216m CPU\u001b[0m"
    },
    {
      "type": "gpu",
      "format": "{2} {7}",
      "key": "  \u001b[38;2;216;191;216m󰋵 GPU\u001b[0m"
    },
    {
      "type": "disk",
      "key": "  \u001b[38;2;216;191;216m Disk\u001b[0m"
    },
    {
      "type": "memory",
      "key": "  \u001b[38;2;216;191;216m Memory\u001b[0m"
    },
    {
      "type": "wifi",
      "key": "  \u001b[38;2;179;217;255m WiFi\u001b[0m"
    },
    {
      "type": "localip",
      "showIpv6": false,
      "showMac": false,
      "showSpeed": false,
      "showMtu": false,
      "showLoop": false,
      "showFlags": false,
      "showAllIps": false,
      "key": "  \u001b[38;2;179;217;255m󱦂 LAN\u001b[0m"
    },
    {
      "type": "publicip",
      "timeout": 500,
      "url": "http://4.ipw.cn",
      "key": "  \u001b[38;2;179;217;255m󰩟 WAN\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;203;178;254m╰────────────────────────────────────────────────────────╯\u001b[0m"
    },
    "break",
    // 🎨 3. Session 区块（重点修正了 WM 模块输出格式）
    {
      "type": "custom",
      "format": "\u001b[38;2;203;178;254m  🎨 Session \u001b[38;2;216;191;216m───────────────────────────────\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;203;178;254m╭────────────────────────────────────────────────────────╮\u001b[0m"
    },
    {
      "type": "terminal",
      "key": "  \u001b[38;2;203;178;254m Terminal\u001b[0m"
    },
    {
      "type": "wm",
      "key": "  \u001b[38;2;203;178;254m WM\u001b[0m",
      "format": "DWM + GlazeWM" // 🌟 限制格式，防止整行文本过长挤出右侧框线导致折行
    },
    {
      "type": "datetime",
      "key": "  \u001b[38;2;203;178;254m󰃰 Time\u001b[0m",
      "format": "{1}-{3}-{11} {14}:{17}"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;203;178;254m╰────────────────────────────────────────────────────────╯\u001b[0m"
    },
    "break",
    // 🎨 底部圆点色块
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}